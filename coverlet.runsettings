<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Exclude>
            [XPoster]XPoster.DirectFunctionExecutor,
            [XPoster]XPoster.FunctionExecutorAutoStartup,
            [XPoster]XPoster.FunctionExecutorHostBuilderExtensions,
            [XPoster]XPoster.FunctionMetadataProviderAutoStartup,
            [XPoster]XPoster.GeneratedFunctionMetadataProvider,
            [XPoster]XPoster.WorkerExtensionStartupCodeExecutor,
            [XPoster]XPoster.WorkerHostBuilderFunctionMetadataProviderExtension,
            [XPoster]XPoster.Extensions.HttpClientExtensions,
            [XPoster]XPoster.Program
          </Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
