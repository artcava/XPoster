{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "CronSchedule": "0 0 6,8,14,16 * * *",
    "AiProvider": "OpenAi",

    "X_API_KEY": "",
    "X_API_SECRET": "",
